<Window x:Class="Packpier.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Packpier" Width="760" Height="440" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="24">
    <TextBlock x:Name="Heading" DockPanel.Dock="Top" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
    <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="0,16,0,0" TextWrapping="Wrap" />
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="148" />
        <ColumnDefinition Width="3*" />
      </Grid.ColumnDefinitions>
      <ListBox x:Name="Plugins" DisplayMemberPath="Name" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8" /></Style>
        </ListBox.ItemContainerStyle>
      </ListBox>
      <StackPanel Grid.Column="1" Margin="20,4,0,0" DataContext="{Binding SelectedItem, ElementName=Plugins}">
        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding Version, StringFormat=v{0}}" Margin="0,4,0,12" />
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
